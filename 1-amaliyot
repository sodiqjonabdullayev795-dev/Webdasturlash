<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AutoBozor — Avtomobil E'lonlari Platformasi</title>
    <!-- FontAwesome Ikonkalari -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #2563eb;
            --primary-dark: #1d4ed8;
            --bg-color: #f8fafc;
            --card-bg: #ffffff;
            --text-color: #0f172a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --radius: 12px;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.6;
        }

        /* Header / Navbar */
        .header {
            background-color: var(--card-bg);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .navbar {
            max-width: 1200px;
            margin: 0 auto;
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary-color);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .nav-links {
            display: flex;
            gap: 1.5rem;
            list-style: none;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--text-color);
            font-weight: 500;
            transition: color 0.2s;
        }

        .nav-links a:hover {
            color: var(--primary-color);
        }

        .btn {
            padding: 0.6rem 1.2rem;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
        }

        .btn-primary {
            background-color: var(--primary-color);
            color: white;
        }

        .btn-primary:hover {
            background-color: var(--primary-dark);
        }

        .btn-outline {
            background-color: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-color);
        }

        .btn-outline:hover {
            background-color: var(--bg-color);
        }

        /* Hero / Qidiruv Bo'limi */
        .hero {
            background: linear-gradient(rgba(15, 23, 42, 0.7), rgba(15, 23, 42, 0.7)), url('https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=1600&q=80') center/cover;
            color: white;
            padding: 4rem 1.5rem;
            text-align: center;
        }

        .hero h1 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }

        .search-box {
            max-width: 1000px;
            margin: 2rem auto 0;
            background: white;
            padding: 1.5rem;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            align-items: end;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            text-align: left;
        }

        .form-group label {
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--text-color);
        }

        .form-control {
            padding: 0.6rem;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            font-size: 1rem;
            outline: none;
        }

        .form-control:focus {
            border-color: var(--primary-color);
        }

        /* Container & Asosiy Kontent */
        .container {
            max-width: 1200px;
            margin: 3rem auto;
            padding: 0 1.5rem;
        }

        .section-title {
            font-size: 1.75rem;
            margin-bottom: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* Grid - E'lonlar Card'lari */
        .cars-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
        }

        .car-card {
            background-color: var(--card-bg);
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .car-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

        .car-img {
            position: relative;
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 0.25rem 0.6rem;
            border-radius: 20px;
            font-size: 0.75rem;
        }

        .car-body {
            padding: 1.25rem;
        }

        .car-title {
            font-size: 1.2rem;
            margin-bottom: 0.5rem;
        }

        .car-price {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--primary-color);
            margin-bottom: 1rem;
        }

        .car-details {
            display: flex;
            justify-content: space-between;
            color: var(--text-muted);
            font-size: 0.875rem;
            border-top: 1px solid var(--border-color);
            padding-top: 0.75rem;
            margin-bottom: 1rem;
        }

        .car-details span {
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .car-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: var(--text-muted);
            font-size: 0.8rem;
        }

        /* Footer */
        .footer {
            background-color: #0f172a;
            color: #94a3b8;
            padding: 3rem 1.5rem 1.5rem;
            margin-top: 5rem;
        }

        .footer-grid {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .footer-col h3 {
            color: white;
            margin-bottom: 1rem;
        }

        .footer-col ul {
            list-style: none;
        }

        .footer-col ul li {
            margin-bottom: 0.5rem;
        }

        .footer-col a {
            color: inherit;
            text-decoration: none;
        }

        .footer-col a:hover {
            color: white;
        }

        .footer-bottom {
            max-width: 1200px;
            margin: 0 auto;
            text-align: center;
            padding-top: 1.5rem;
            border-top: 1px solid #1e293b;
            font-size: 0.875rem;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .nav-links {
                display: none;
            }
        }
    </style>
</head>
<body>

    <!-- Header Section -->
    <header class="header">
        <nav class="navbar">
            <a href="#" class="logo">
                <i class="fa-solid => fa-car-side"></i> AutoBozor
            </a>
            <ul class="nav-links">
                <li><a href="#">Bosh sahifa</a></li>
                <li><a href="#">E'lonlar</a></li>
                <li><a href="#">Dilerlar</a></li>
                <li><a href="#">Xizmatlar</a></li>
            </ul>
            <div style="display: flex; gap: 0.5rem;">
                <a href="#" class="btn btn-outline"><i class="fa-regular fa-user"></i> Kirish</a>
                <a href="#" class="btn btn-primary"><i class="fa-solid fa-plus"></i> E'lon berish</a>
            </div>
        </nav>
    </header>

    <!-- Hero Search Section -->
    <section class="hero">
        <h1>O'zingizga mos avtomobilni toping</h1>
        <p>O'zbekiston bo'ylab 10 000+ dan ortiq yangi va haydalgan avtomobillar</p>
        
        <form class="search-box">
            <div class="form-group">
                <label for="marka">Marka</label>
                <select id="marka" class="form-control">
                    <option value="">Barchasi</option>
                    <option value="chevrolet">Chevrolet</option>
                    <option value="kia">Kia</option>
                    <option value="hyundai">Hyundai</option>
                    <option value="byd">BYD</option>
                </select>
            </div>
            
            <div class="form-group">
                <label for="madel">Model</label>
                <select id="madel" class="form-control">
                    <option value="">Tanlang</option>
                    <option value="cobalt">Cobalt</option>
                    <option value="gentra">Gentra</option>
                    <option value="k5">K5</option>
                    <option value="song-plus">Song Plus</option>
                </select>
            </div>

            <div class="form-group">
                <label for="narx">Maksimal Narx ($)</label>
                <input type="number" id="narx" class="form-control" placeholder="Masalan: 15000">
            </div>

            <div class="form-group">
                <label for="yil">Yil</label>
                <select id="yil" class="form-control">
                    <option value="">Barchasi</option>
                    <option value="2024">2024</option>
                    <option value="2023">2023</option>
                    <option value="2022">2022</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary" style="height: 42px;">
                <i class="fa-solid fa-magnifying-glass"></i> Qidirish
            </button>
        </form>
    </section>

    <!-- Asosiy E'lonlar Section -->
    <main class="container">
        <div class="section-title">
            <h2>So'nggi e'lonlar</h2>
            <a href="#" style="font-size: 1rem; color: var(--primary-color); text-decoration: none;">Barchasini ko'rish &rarr;</a>
        </div>

        <div class="cars-grid">
            <!-- Card 1 -->
            <article class="car-card">
                <div style="position: relative;">
                    <img src="https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=600&q=80" alt="Chevrolet Malibu" class="car-img">
                    <span class="badge">Yangi</span>
                </div>
                <div class="car-body">
                    <h3 class="car-title">Chevrolet Malibu XL</h3>
                    <div class="car-price">$28,500</div>
                    <div class="car-details">
                        <span><i class="fa-solid fa-calendar"></i> 2023</span>
                        <span><i class="fa-solid fa-gauge-high"></i> 12,000 km</span>
                        <span><i class="fa-solid fa-gas-pump"></i> Benzin</span>
                    </div>
                    <div class="car-footer">
                        <span><i class="fa-solid fa-location-dot"></i> Toshkent</span>
                        <a href="#" class="btn btn-outline" style="padding: 0.3rem 0.8rem; font-size: 0.875rem;">Batafsil</a>
                    </div>
                </div>
            </article>

            <!-- Card 2 -->
            <article class="car-card">
                <div style="position: relative;">
                    <img src="https://images.unsplash.com/photo-1617814076367-b759c7d7e738?auto=format&fit=crop&w=600&q=80" alt="BYD Song Plus" class="car-img">
                    <span class="badge" style="background: #16a34a;">Top</span>
                </div>
                <div class="car-body">
                    <h3 class="car-title">BYD Song Plus EV</h3>
                    <div class="car-price">$32,000</div>
                    <div class="car-details">
                        <span><i class="fa-solid fa-calendar"></i> 2024</span>
                        <span><i class="fa-solid fa-gauge-high"></i> 0 km</span>
                        <span><i class="fa-solid fa-bolt"></i> Elektr</span>
                    </div>
                    <div class="car-footer">
                        <span><i class="fa-solid fa-location-dot"></i> Samarqand</span>
                        <a href="#" class="btn btn-outline" style="padding: 0.3rem 0.8rem; font-size: 0.875rem;">Batafsil</a>
                    </div>
                </div>
            </article>

            <!-- Card 3 -->
            <article class="car-card">
                <div style="position: relative;">
                    <img src="https://images.unsplash.com/photo-1580273916550-e323be2ae537?auto=format&fit=crop&w=600&q=80" alt="BMW 5 Series" class="car-img">
                </div>
                <div class="car-body">
                    <h3 class="car-title">BMW 530i M Sport</h3>
                    <div class="car-price">$45,000</div>
                    <div class="car-details">
                        <span><i class="fa-solid fa-calendar"></i> 2021</span>
                        <span><i class="fa-solid fa-gauge-high"></i> 45,000 km</span>
                        <span><i class="fa-solid fa-gas-pump"></i> Benzin</span>
                    </div>
                    <div class="car-footer">
                        <span><i class="fa-solid fa-location-dot"></i> Toshkent</span>
                        <a href="#" class="btn btn-outline" style="padding: 0.3rem 0.8rem; font-size: 0.875rem;">Batafsil</a>
                    </div>
                </div>
            </article>

            <!-- Card 4 -->
            <article class="car-card">
                <div style="position: relative;">
                    <img src="https://images.unsplash.com/photo-1541899481282-d53bffe3c35d?auto=format&fit=crop&w=600&q=80" alt="Kia K5" class="car-img">
                </div>
                <div class="car-body">
                    <h3 class="car-title">Kia K5 Style</h3>
                    <div class="car-price">$25,000</div>
                    <div class="car-details">
                        <span><i class="fa-solid fa-calendar"></i> 2022</span>
                        <span><i class="fa-solid fa-gauge-high"></i> 30,000 km</span>
                        <span><i class="fa-solid fa-gas-pump"></i> Benzin</span>
                    </div>
                    <div class="car-footer">
                        <span><i class="fa-solid fa-location-dot"></i> Farg'ona</span>
                        <a href="#" class="btn btn-outline" style="padding: 0.3rem 0.8rem; font-size: 0.875rem;">Batafsil</a>
                    </div>
                </div>
            </article>
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-grid">
            <div class="footer-col">
                <h3>AutoBozor</h3>
                <p>O'zbekistondagi eng yirik va qulay avtomobil e'lonlari platformasi.</p>
            </div>
            <div class="footer-col">
                <h3>Xaridorlarga</h3>
                <ul>
                    <li><a href="#">Avtomobillar</a></li>
                    <li><a href="#">Dilerlar bazasi</a></li>
                    <li><a href="#">Avto kredit</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>Sotuvchilarga</h3>
                <ul>
                    <li><a href="#">E'lon joylashtirish</a></li>
                    <li><a href="#">Tariflar</a></li>
                    <li><a href="#">Qoidalar</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>Aloqa</h3>
                <ul>
                    <li><i class="fa-solid fa-phone"></i> +998 71 200 00 00</li>
                    <li><i class="fa-solid fa-envelope"></i> info@autobozor.uz</li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 AutoBozor. Barcha huquqlar himoyalangan.</p>
        </div>
    </footer>

</body>
</html>
